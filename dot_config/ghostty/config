# ═══════════════════════════════════════════
# Ghostty Config — Optimized for Claude Code
# ═══════════════════════════════════════════

# --- Theme ---
theme = Houston

# --- Font ---
font-family = JetBrains Mono
font-size = 15
font-thicken = true
font-feature = +calt
font-feature = +liga

# --- Window ---
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true
window-save-state = always
window-inherit-working-directory = true
macos-titlebar-style = tabs

# Herdr owns ⌘T and the custom ZMK keyboard's Ctrl+Tab shortcuts.
# Ghostty keeps its default ⌘N binding for new windows.
keybind = super+t=unbind
keybind = ctrl+shift+tab=csi:9;6u
keybind = ctrl+tab=csi:9;5u

# ⌘↩ defaults to toggle_fullscreen; unbound so it does nothing.
keybind = super+enter=unbind

# --- Cursor ---
cursor-style = bar
cursor-style-blink = false

# --- Scrollback ---
scrollback-limit = 100000

# --- Shell Integration ---
shell-integration = detect
shell-integration-features = cursor,sudo,title

# --- Clipboard ---
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true

# --- Mouse ---
mouse-hide-while-typing = true

# --- Claude Code: Shift+Enter for multiline input ---
keybind = shift+enter=text:\x1b\r

# --- Quick Terminal (Ctrl+` from any app) ---
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-animation-duration = 0.2

# --- Split Navigation ---
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down
keybind = super+alt+enter=toggle_split_zoom
keybind = super+alt+equal=equalize_splits

# --- Prompt Jumping (navigate between shell prompts) ---
keybind = super+shift+up=jump_to_prompt:-1
keybind = super+shift+down=jump_to_prompt:1

# --- Float on Top (keep visible while coding) ---
keybind = super+ctrl+f=toggle_window_float_on_top

# --- Export Scrollback to file ---
keybind = super+shift+b=write_scrollback_file:open

background-opacity = 1.00
