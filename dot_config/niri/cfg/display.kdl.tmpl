// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// You will have to remove "/-" and edit it before it takes effect.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

{{- if eq .chezmoi.hostname "thinkpad" }}
/- output "DP-1" {
    mode "2560x1440@359.979" // Set resolution and refresh rate
    scale 1 // No scaling (use 2 for HiDPI)
}

// ASUS XG32UCWMG: highest advertised refresh rate at native 4K resolution.
// Match by monitor identity so this survives connector-name changes.
output "ASUSTek COMPUTER INC XG32UCWMG TALMQV023962" {
    mode "3840x2160@100.000"
    scale 1.25
}

output "eDP-1" {
    scale 2
}
{{- else }}
// No machine-specific output overrides are configured for this host.
{{- end }}
