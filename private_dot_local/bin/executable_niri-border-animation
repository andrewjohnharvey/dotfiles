#!/usr/bin/env python3
"""Rotate Niri's dim border gradient once every two minutes."""
import os
from pathlib import Path
import signal
import time

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "niri/animated-border.kdl"


def write_angle(angle):
    text = "// Generated by niri-border-animation; do not edit.\nwindow-rule {\n"
    for node in ("focus-ring", "border"):
        text += f'    {node} {{ active-gradient from="#31585A" to="#285343" angle={int(angle)}; }}\n'
    text += "}\n"
    temporary = CONFIG.with_suffix(".kdl.tmp")
    temporary.write_text(text)
    temporary.chmod(0o600)
    temporary.replace(CONFIG)


def stop(*_):
    raise SystemExit(0)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    while True:
        # Monotonic time avoids jumps when the wall clock changes.
        write_angle((45 + time.monotonic() * 3) % 360)
        time.sleep(1)
