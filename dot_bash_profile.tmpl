# Load Ubuntu's login environment (including ~/.bashrc and user PATHs).
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") }}
[[ -f ~/.profile ]] && . ~/.profile
{{- else }}
[[ -f ~/.bashrc ]] && . ~/.bashrc
{{- end }}

{{ if eq .chezmoi.hostname "huginn" }}
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"
eval "$("$HOME/.local/bin/mise" activate bash --shims)"
mup() { "$HOME/.local/bin/huginn-mup" "$@"; }
{{ end }}
