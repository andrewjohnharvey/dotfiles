# Load Ubuntu's login environment (including ~/.bashrc and user PATHs).
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") }}
[[ -f ~/.profile ]] && . ~/.profile
{{- else }}
[[ -f ~/.bashrc ]] && . ~/.bashrc
{{- end }}

{{ if eq .chezmoi.hostname "thor" }}
# .profile adds user paths after .bashrc; restore mise precedence for login shells.
if [[ -x "$HOME/.local/bin/mise" ]]; then
    if [[ $- == *i* ]]; then
        eval "$("$HOME/.local/bin/mise" activate bash)"
    else
        eval "$("$HOME/.local/bin/mise" activate bash --shims)"
    fi
fi
{{ end }}
